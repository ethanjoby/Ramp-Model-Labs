# Firebase web config for Google sign-in (Firebase console → Project settings → Your apps → Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local testing only, with `firebase emulators:start --only auth` running:
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
