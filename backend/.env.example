# Enables the Claude agents, synthetic data, prompted candidates and the cascade's LLM level.
ANTHROPIC_API_KEY=

# Together AI (OpenAI-compatible). Adds DeepSeek, Kimi, MiniMax, GLM and Qwen as zero-shot candidates, and runs the
# agents (planner, synthesizer, teacher, yardstick) when no Anthropic key is set. Prices come from the catalog list.
TOGETHER_API_KEY=
# TOGETHER_MODELS=deepseek-ai/DeepSeek-V4.1-Flash-1017,moonshotai/Kimi-K3.1-Pro,MiniMaxAI/MiniMax-M3.1-Flash,zai-org/GLM-5.3-Flash,Qwen/Qwen3.5-9B
# TOGETHER_AGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# TOGETHER_REFERENCE_MODEL=moonshotai/Kimi-K3.1-Pro

# Local candidates (torch is installed by uv sync). Set LOCAL_LLM_MODEL= (empty) to skip the 0.6B decoder, which adds ~3 min per lab.
# LOCAL_LLM_MODEL=Qwen/Qwen3-0.6B
# LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Real fine-tuning on a GPU. First run: uv run modal token new && uv run modal deploy modal_app.py
MODAL_ENABLED=false
# MODAL_MODELS=Qwen/Qwen3-1.7B,Qwen/Qwen3-4B-Instruct-2507   # the LoRA roster; overrides MODAL_BASE_MODEL / MODAL_HEAVY_MODEL

# After training, the strongest expensive candidate labels unlabeled rows for the cheapest local one when it clearly lags.
DISTILL=true
# DISTILL_ROWS=1500

# Production only
SECRET_KEY=
COOKIE_SECURE=false

# Firebase project used for Google sign-in (frontend/.env.local holds the matching web config)
FIREBASE_PROJECT_ID=
