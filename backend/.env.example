# Enables the Claude agents, synthetic data, prompted candidates and the cascade's LLM level.
ANTHROPIC_API_KEY=

# Real fine-tuning. First run: uv run modal token new && uv run modal deploy modal_app.py
MODAL_ENABLED=false

# Production only
SECRET_KEY=
COOKIE_SECURE=false

# Firebase project used for Google sign-in (frontend/.env.local holds the matching web config)
FIREBASE_PROJECT_ID=
